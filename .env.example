BASE_URL=https://www.rmtcgoiania.com.br/
PREFIX_URL=index.php

# Raiz do data lake local (bronze/silver/quarantine)
DATA_DIR=database
# Docker: pasta do host montada em /data (padrão ./database)
# DATA_HOST_DIR=C:/data/rmtc_go
TIMEZONE=America/Sao_Paulo

# Agendamento da pipeline (cron, no fuso de TIMEZONE)
LOCATE_BUS_CRON="* * * * *"
LINHA_KML_CRON="30 5 * * *"
# linha_kml só refazendo uso + tracado (sem baixar KML), para o dia corrente
LINHA_KML_USO_CRON="15 * * * *"

HTTP_TIMEOUT=30
HTTP_RETRIES=3

API_HOST=0.0.0.0
API_PORT=3001
API_RELOAD=true

# Faz os logs do pacote aparecerem na UI do Prefect
PREFECT_LOGGING_EXTRA_LOGGERS=rmtc_go
